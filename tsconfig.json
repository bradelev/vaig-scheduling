{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "comment:exclude": "Deno scripts/functions use the Deno global + top-level await; they are type-checked with `deno check`, not tsc. Their pure, Node-importable helpers (e.g. scripts/seed-plan.ts) stay in tsc.",
  "exclude": [
    "node_modules",
    "supabase/functions",
    "scripts/seed.ts",
    "scripts/merge-fichas.ts"
  ]
}
