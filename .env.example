# ── Local development ────────────────────────────────────────────
# No production values are ever filled in for local dev/tests.
# There is no local Supabase stack (no Docker): unit tests run on
# fixtures/mocks; integration tests run in CI against the runner's
# ephemeral stack. Production lives only in the Vercel and Supabase
# dashboards ([HUMAN] task).

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp Cloud API (prod only — never in the repo or in CI)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=

# Google Calendar (service account with the calendar shared read-only)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=   # PEM, single line with \n escapes (reused from v1)
GOOGLE_CALENDAR_ID=

# App
TIMEZONE=America/Montevideo
REACTIVATION_DAYS=21
STAFF_EMAILS=                 # comma-separated allowlist

# Operational notifications (E6-T3) — all optional; a missing var skips
# that channel. Contacts are personal data: secrets only, never the repo.
NOTIFY_ADMIN_PHONE=            # daily reminder summary (WhatsApp, +598...)
NOTIFY_ADMIN_EMAIL=            # daily reminder summary (email)
NOTIFY_TECH_PHONE=             # failure/recovery alerts (WhatsApp)
NOTIFY_TECH_EMAIL=             # failure/recovery alerts (email)
RESEND_API_KEY=                # email channel (resend.com)
NOTIFY_EMAIL_FROM=             # verified sender, e.g. "VAIG <vaig@dominio>"

# Rehearsal mode (issue #60) — when set, EVERY reminder send goes to this
# phone instead of the client's (E.164, e.g. +59891234500). Set it to test
# the full pipeline without contacting clients; MUST be unset for go-live
# (`supabase secrets unset TEST_PHONE_OVERRIDE`). Malformed value = the
# batch aborts instead of falling back to real phones.
TEST_PHONE_OVERRIDE=

# Free-text auto-redirect on the bot number (issue #74) — the shop's HUMAN
# WhatsApp in E.164 (+598...). Unset = feature off (ships dark): free text
# to the bot is silently ignored, as before.
SHOP_WHATSAPP=

# --- Public online booking (reservas.<domain>) ---------------------------------
# Hostname of the client-facing booking site. On this host the root and any
# staff path redirect to /reservar (the staff app is never shown there).
# Unset = no host-based redirect (e.g. local dev on localhost).
PUBLIC_BOOKING_HOST=reservas.example.com
# Secret "pepper" for hashing the phone-login codes (any long random string,
# e.g. `openssl rand -hex 32`). Required for /api/client-auth.
OTP_PEPPER=
# Set to 1 in LOCAL dev to never hit Meta: WhatsApp sends are logged instead
# (the login code appears in the server console). Never set in production.
CLIENT_AUTH_TEST_MODE=
